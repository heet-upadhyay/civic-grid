# Gemini API configuration
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# Optional: Set to 'true' to use deterministic offline classifier without API calls
USE_MOCK_CLASSIFIER=false

# Optional: Cloud PostgreSQL database URL (e.g. Supabase, Neon, Render Postgres)
# If left unset, CivicGrid automatically falls back to local SQLite at CIVICGRID_DB_PATH
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Optional: Path to SQLite database file (when DATABASE_URL is not set)
CIVICGRID_DB_PATH=data/civicgrid.db

# Optional: Comma-separated list of allowed CORS origins (e.g. https://my-app.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
