# -----------------------------------------------
# Frontend .gitignore
# -----------------------------------------------

# Dependencies
node_modules/

# Production build outputs
dist/
dist-ssr/

# Environment files & Secrets
.env
.env.*
!.env.example
*.local

# Cache directories
.vite/
.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage
coverage/

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
